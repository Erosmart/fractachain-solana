# Fractachain Frontend Environment Configuration
#
# API routing (pick one):
# 1) Local / Docker (recommended): leave NEXT_PUBLIC_API_URL empty so the browser
#    calls same-origin `/api/*`. Next App Router proxies those to BACKEND_URL
#    at **runtime** (no rebuild when only BACKEND_URL changes).
# 2) Split hosted FE/BE (browser → public API): set NEXT_PUBLIC_API_URL to the
#    *public Express* origin (never the frontend URL). Rebuild after changing it.
#
# Do NOT bake http://localhost:8080 into NEXT_PUBLIC_API_URL on a hosted build —
# the old client rewrite turned that into the page host and login parsed HTML as JSON.
#
# Docker Compose sets BACKEND_URL=http://backend:8080 on the frontend service.
# On Railway, set BACKEND_URL to the Express service URL (private or public) —
# hostname "backend" does not resolve there unless you create that DNS name.
# Empty / localhost BACKEND_URL on Railway → startup refuse + /health 503
# backend_misconfigured (never silently proxy to localhost in the container).

# Public backend origin for the browser (optional if using same-origin proxy)
# NEXT_PUBLIC_API_URL=http://localhost:8080
# NEXT_PUBLIC_API_URL=https://your-express-api.up.railway.app

# Server-side proxy target (runtime). Local next dev → localhost Express.
BACKEND_URL=http://localhost:8080
# Railway (required on the Next service — NOT localhost):
# BACKEND_URL=http://${{express.RAILWAY_PRIVATE_DOMAIN}}:${{express.PORT}}
# BACKEND_URL=https://your-express-api.up.railway.app

# Solana RPC (Devnet)
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Firebase Authentication (Google Sign-In sin configurar OAuth en Google Cloud directamente)
# Obtenidos en Firebase Console > Configuración del Proyecto > General > Tus apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Sin Firebase el login anda igual con email + contraseña contra el backend en :8080.
# Google: Firebase Console > Authentication > Sign-in method > Google > Enable,
# copiá las claves de la app Web, pegá en frontend/.env.local y agregá
# http://localhost:3000 y tu LAN (ej. http://192.168.0.14:3000) en Authorized domains.
