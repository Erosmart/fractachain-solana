# Fractachain Frontend Environment Configuration
#
# API routing (pick one):
# 1) Local / Docker (recommended): leave NEXT_PUBLIC_API_URL empty so the browser
#    calls same-origin `/api/*`. Next.js rewrites those to BACKEND_URL.
# 2) Split hosted FE/BE: set NEXT_PUBLIC_API_URL to the *public backend* origin
#    (never the frontend URL). Rebuild the frontend after changing it.
#
# Do NOT bake http://localhost:8080 into a hosted frontend build — the old
# client rewrite turned that into the page host and login parsed HTML as JSON.

# Public backend origin for the browser (optional if using same-origin proxy)
# NEXT_PUBLIC_API_URL=http://localhost:8080
# NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app

# Server-side proxy target used by next.config.js rewrites (Docker/Railway)
BACKEND_URL=http://localhost:8080

# Solana RPC (Devnet)
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Firebase Authentication (Google Sign-In sin configurar OAuth en Google Cloud directamente)
# Obtenidos en Firebase Console > Configuración del Proyecto > General > Tus apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Sin Firebase el login anda igual con email + contraseña contra el backend en :8080.
# Google: Firebase Console > Authentication > Sign-in method > Google > Enable,
# copiá las claves de la app Web, pegá en frontend/.env.local y agregá
# http://localhost:3000 y tu LAN (ej. http://192.168.0.14:3000) en Authorized domains.
