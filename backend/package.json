{
  "name": "fractachain-backend",
  "version": "1.0.0",
  "description": "Fractachain Administration, KYC, Custody and Mocks Backend API (Railway Ready)",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "node --use-system-ca ./node_modules/ts-node-dev/lib/bin.js --respawn --transpile-only src/server.ts",
    "test": "node --use-system-ca ./node_modules/ts-node/dist/bin.js src/test_runner.ts"
  },
  "dependencies": {
    "@cks-systems/manifest-sdk": "0.2.38",
