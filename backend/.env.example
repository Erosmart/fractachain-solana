# ── Backend — Solana ───────────────────────────────────────────────
PORT=8080
ADMIN_EMAILS=tu-email@dominio.com
# Genesis demo: el KYC onboarding se aprueba solo para poder cerrar el loop inversor.
HACKATHON_DEMO=true
AUTH_PEPPER=cambia-esto-antes-de-compartir-el-host
WALLET_PEPPER=cambia-esto-tambien

# ── Cluster ────────────────────────────────────────────────────────
# devnet | testnet | localnet | mainnet-beta
SOLANA_CLUSTER=devnet
# Dejalo vacío para usar el RPC público del cluster.
# SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_COMMITMENT=confirmed
# true = airdrop de SOL devnet + USDC demo al registrar wallets. Apagado por
# defecto: sin esto el backend no hace ninguna llamada de faucet a la red.
SOLANA_AUTO_FAUCET=false

# Programa Anchor (env > deployments/devnet.json > placeholder — el env gana,
# útil en Railway para no rebuildar la imagen tras el deploy del contrato).
# FRACTACHAIN_PROGRAM_ID=
# true = el backend trata el programa como deployado (modo on-chain).
# Sin esto (ni deployedAt en devnet.json) corre en modo sandbox.
# FRACTACHAIN_PROGRAM_DEPLOYED=false

# ── Claves (base58 secret key de 64 bytes — JSON array o base58) ─────
# Admin de la plataforma: firma create_offering/mint/open/verify_investor/etc.
# Generarla con: solana-keygen new --outfile admin.json (NUNCA commitear el archivo)
SOLANA_ADMIN_SECRET_KEY=
# Mint authority del USDC de devnet (para el faucet mock de USDC).
# En mainnet-beta dejalo vacío: el USDC real no se puede mintear.
SOLANA_USDC_MINT_AUTHORITY=
# Issuer alternativo para emisiones (default: el admin).
# SOLANA_ISSUER_SECRET_KEY=

# ── Payment mints ──────────────────────────────────────────────────
# Mint SPL del USDC del cluster. En devnet puede ser tu mock mint;
# en mainnet-beta el USDC de Circle (EPjFWdd5...).
SOLANA_USDC_MINT=
# SOLANA_USDT_MINT=

# ── KYC ────────────────────────────────────────────────────────────
# true = aprobaciones on-chain solo en horario hábil ART (L-V 08-16)
KYC_ENFORCE_HOURS=false

# ── Opcionales ─────────────────────────────────────────────────────
# Postgres para persistencia (sin esto usa JSON en data/)
# DATABASE_URL=postgres://user:pass@host:5432/fractachain
# Intervalo del sweep de settle automático (ms). 0 = desactivado.
# SETTLEMENT_SWEEP_MS=60000
